# cqserver lab — leader (role=primary, ships to one or more followers
# across a LAN). Designed for the two-Mac lab setup; see
# tests/cloud/lab/README.md for the full procedure.
#
# Env vars consumed at startup (via `${VAR:-default}` substitution):
#   PEERS_TOML_LIST — pre-rendered TOML array, e.g. ["10.0.0.5:9010"]
#                     (the lab-up-leader.sh script builds this from
#                     $FOLLOWER1_IP + optional $FOLLOWER2_IP)
#   LAB_TXLOG_DIR   — txlog root (default: /tmp/cqserver-lab/leader/txlog)
#   LAB_BIND_IP     — what addr to listen on for clients
#                     (default 0.0.0.0; set to 127.0.0.1 for loopback only)

tcp_addr       = "${LAB_BIND_IP:-0.0.0.0}:9007"
websocket_addr = "${LAB_BIND_IP:-0.0.0.0}:9008"
websocket_path = "/cq/json"
admin_addr     = "${LAB_BIND_IP:-0.0.0.0}:8085"

heartbeat_interval_s     = 60
heartbeat_idle_timeout_s = 600

[transport]
outbound_queue_capacity = 2048
sow_batch_size          = 200

[txlog]
directory = "${LAB_TXLOG_DIR:-/tmp/cqserver-lab/leader/txlog}"

[replication]
role  = "primary"
# PEERS_TOML_LIST is rendered by lab-up-leader.sh as a clean TOML
# array literal (no trailing commas, no empty entries). Example:
#   peers = ["192.168.1.20:9010", "192.168.1.21:9010"]
peers = ${PEERS_TOML_LIST}

[[topics]]
name             = "/lab-orders"
key              = ["order_id"]
persist          = true
initial_capacity = 100000
columns          = [
  { name = "order_id", type = "string" },
  { name = "book",     type = "string" },
  { name = "qty",      type = "long"   },
  { name = "price",    type = "double" },
]
