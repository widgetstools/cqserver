{
  "name": "@cqserver/client",
  "version": "0.1.0",
  "description": "Async TypeScript/JavaScript client SDK for cqserver",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "publish-fi-demo": "tsx examples/fi-publisher.ts",
    "generate-fi-data": "tsx examples/generate-fi-data.ts",
    "load-fi-data": "tsx examples/load-fi-data.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "@types/node": "^20.12.7",
    "tsx": "^4.7.0"
  }
}
